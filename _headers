/*
 * _headers — Security headers for Cloudflare Pages / Netlify
 * GitHub Pages doesn't process this file, but it's included for
 * future migrations and documents intended header policy.
 *
 * For GitHub Pages: headers are set at the Cloudflare Proxy level
 * (if using Cloudflare in front of GitHub Pages).
 */

/*
  Apply to all pages
*/
https://princeyadav7.github.io/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 1; mode=block
